title: Inter-politics
new-page: true
is-special: true
on-arrival: {!
data = [
    {
        "id": "kpp",
        "legend": "KPP",
        "name": "KPP",
        "seats": Math.round(Q.kpp_sj*4.44),
    },
    {
        "id": "pps",
        "legend": "PPS",
        "name": "PPS",
        "seats": Math.round(Q.pps_sj*4.44),
    },
    {
        "id": "npr",
        "legend": "NPR",
        "name": "NPR",
        "seats": Math.round(Q.npr_sj*4.44),
    },
    {
        "id": "psl_l",
        "legend": "PSL-L",
        "name": "PSL-L",
        "seats": Math.round(Q.psl_l_sj*4.44),
    },
    {
        "id": "psl_w",
        "legend": "PSL-W",
        "name": "PSL-W",
        "seats": Math.round(Q.psl_w_sj*4.44),
    },
    {
        "id": "psl_p",
        "legend": "PSL-P",
        "name": "PSL-P",
        "seats": Math.round(Q.psl_p_sj*4.44),
    },
    {
        "id": "bmn",
        "legend": "BMN",
        "name": "BMN",
        "seats": Math.round(Q.bmn_sj*4.44),
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_sj*4.44),
    },
    {
        "id": "zln",
        "legend": "ZLN",
        "name": "ZLN",
        "seats": Math.round(Q.zln_sj*4.44),
    },
    {
        "id": "pschd",
        "legend": "PSChD",
        "name": "PSChD",
        "seats": Math.round(Q.pschd_sj*4.44),
    },
    {
        "id": "otherright",
        "legend": "Other Parties",
        "name": "Other Parties",
        "seats": Math.round(Q.otherright_sj*4.44),
    },
];

data_sn = [
    {
        "id": "kpp",
        "legend": "KPP",
        "name": "KPP",
        "seats": Math.round(Q.kpp_sn*1.11),
    },
    {
        "id": "pps",
        "legend": "PPS",
        "name": "PPS",
        "seats": Math.round(Q.pps_sn*1.11),
    },
    {
        "id": "npr",
        "legend": "NPR",
        "name": "NPR",
        "seats": Math.round(Q.npr_sn*1.11),
    },
    {
        "id": "psl_l",
        "legend": "PSL-L",
        "name": "PSL-L",
        "seats": Math.round(Q.psl_l_sn*1.11),
    },
    {
        "id": "psl_w",
        "legend": "PSL-W",
        "name": "PSL-W",
        "seats": Math.round(Q.psl_w_sn*1.11),
    },
    {
        "id": "psl_p",
        "legend": "PSL-P",
        "name": "PSL-P",
        "seats": Math.round(Q.psl_p_sn*1.11),
    },
    {
        "id": "bmn",
        "legend": "BMN",
