    },
    {
        "id": "pschd",
        "legend": "PSChD",
        "name": "PSChD",
        "seats": Math.round(Q.pschd_sn*1.11),
    },
    {
        "id": "otherright",
        "legend": "Other Parties",
        "name": "Other Parties",
        "seats": Math.round(Q.otherright_sn*1.11),
    },
];
setTimeout(function() {
    if (typeof window !== 'undefined' && typeof d3 !== 'undefined' && d3.parliament) {
        
        // Render Sejm
        var width1 = 500; 
        var height1 = 500;
        var elementSejm = document.getElementById("sejm");
        if (elementSejm) {
            var screenWidth = document.getElementById('content').offsetWidth;
            if (screenWidth < width1 - 50) {
                width1 = screenWidth - 50; 
                height1 = width1;
                elementSejm.style.height = (screenWidth / 2) + "px";
            } 
            var parliament1 = d3.parliament();
            parliament1.width(width1).height(height1).innerRadiusCoef(0.4);
            parliament1.enter.fromCenter(true).smallToBig(true);
            parliament1.exit.toCenter(false).bigToSmall(true);
            d3.select("#sejm").datum(data).call(parliament1);
        }

        // Render Senat
        var width2 = 500; 
        var height2 = 500;
        var elementSenat = document.getElementById("senat");
        if (elementSenat) {
            var screenWidth = document.getElementById('content').offsetWidth;
            if (screenWidth < width2 - 50) {
                width2 = screenWidth - 50; 
                height2 = width2;
                elementSenat.style.height = (screenWidth / 2) + "px";
            } 
            var parliament2 = d3.parliament();
            parliament2.width(width2).height(height2).innerRadiusCoef(0.4);
            parliament2.enter.fromCenter(true).smallToBig(true);
            parliament2.exit.toCenter(false).bigToSmall(true);
            d3.select("#senat").datum(data_sn).call(parliament2);
        }
    }
}, 50);
!}

= Government Composition
<div style="text-align: center;">**Sejm**</div>
{!<svg id="sejm" style="width: 500px; height: 250px;"> </svg>!}
<div style="text-align: center;">Prime Minister: [+ prime_minister +] ([+ prime_minister_party +])</div>

<div style="text-align: center;">**Senate**</div>
{!<svg id="senat" style="width: 500px; height: 250px;"> </svg>!}

<div style="text-align: center;">[? if (right_sn > left_sn) and (right_sn > center_sn) : The Senat is dominated by the Right. ?][? if (left_sn > right_sn) and (left_sn > center_sn) : The Senat is dominated by the Left. ?][? if (center_sn >= right_sn) and (center_sn >= left_sn) : The Senat is dominated by the Centrists.</div>

@actions

