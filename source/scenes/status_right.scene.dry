title: Inter-politics
new-page: true
is-special: true
on-display: {!
data_sj = Q.sj_display;
if (window && d3) {
    var data_sj = Q.sj_display;
var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("sejm_display").style.height = screenWidth/2 + "px";
    } 

    var parliament_sj_display = d3.parliament();
    parliament_sj_display.width(width).height(height).innerRadiusCoef(0.4);
    parliament_sj_display.enter.fromCenter(true).smallToBig(true);
    parliament_sj_display.exit.toCenter(false).bigToSmall(true);
    d3.select("#sejm_display").datum(data).call(parliament);
}
data_sn = Q.sn_display;
if (window && d3) {
    var data_sn = Q.sn_display;
var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("senat_display").style.height = screenWidth/2 + "px";
    } 

    var parliament_sn_display = d3.parliament();
    parliament_sn_display.width(width).height(height).innerRadiusCoef(0.4);
    parliament_sn_display.enter.fromCenter(true).smallToBig(true);
    parliament_sn_display.exit.toCenter(false).bigToSmall(true);
    d3.select("#senat_display").datum(data).call(parliament);
}
!}

= Parliament

<div style="text-align: center;">**Sejm**</div>
{!<svg id="sejm_display" style="width: 500px; height: 250px;"> </svg>!}
<div style="text-align: center;">Prime Minister: [+ prime_minister +] ([+ prime_minister_party +])</div>

[? if year >= 1923 : <div style="text-align: center;">**Senate**</div>
{!<svg id="senat_display" style="width: 500px; height: 250px;"> </svg>!}

<div style="text-align: center;">[? if (right_sn > left_sn) and (right_sn > center_sn) : The Senat is dominated by the Right. ?][? if (left_sn > right_sn) and (left_sn > center_sn) : The Senat is dominated by the Left. ?][? if (center_sn >= right_sn) and (center_sn >= left_sn) : The Senat is dominated by the Centrists.?]</div>?]
@actions

= Actions

